# Free Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Free Tavily API key (1000 searches/month): https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Agent model
GEMINI_MODEL=gemini-2.0-flash

# Max tool-calling iterations before agent gives up
MAX_ITERATIONS=10

# SQLite DB path (created by data/seed_db.py)
DB_PATH=data/company.db
