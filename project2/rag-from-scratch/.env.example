# Free Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Free Qdrant Cloud: https://cloud.qdrant.io
# Create a cluster -> copy the URL and API key
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Collection name (acts like a table name in a DB)
COLLECTION_NAME=rag_documents

# Models
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Chunking - tune these to improve answer quality
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# How many chunks to retrieve per query
TOP_K=4
